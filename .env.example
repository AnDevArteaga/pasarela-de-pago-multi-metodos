# Una réplica. En Railway apaga App Sleeping: el cron de cobros no corre si el contenedor duerme.
# Postgres va en un servicio aparte. DATABASE_URL puede ser postgres://...

APP_ENV=test
PORT=8080
DATABASE_URL=postgres://pasarela:pasarela@localhost:5432/pasarela
PUBLIC_BASE_URL=http://localhost:8080

WOMPI_PUBLIC_KEY=pub_test_
WOMPI_PRIVATE_KEY=prv_test_
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

RESEND_API_KEY=
ADMIN_TOKEN=
SEED_DEMO=true

# Solo producción aplica el límite. En test (APP_ENV=test) no hay rate limit.
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_FAILED_CHARGES_PER_HOUR=5
TRUSTED_PROXIES=
